{
  "name": "flexurl-create",
  "version": "1.0.0",
  "description": "Privacy-first link shortener — create.flexurl.link",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 execute flexurl --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute flexurl --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "nanoid": "^5.1.6",
    "next": "^16.1.4",
    "pg": "^8.21.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "wrangler": "^3.107.0"
  }
}
